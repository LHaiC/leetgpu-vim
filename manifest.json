{
  "manifest_version": 3,
  "name": "Vim for LeetGPU",
  "version": "1.0.0",
  "description": "Vim keybindings for the code editor on leetgpu.com, powered by monaco-vim.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://leetgpu.com/*", "https://www.leetgpu.com/*"],
      "js": ["vendor/monaco-vim.js", "src/vim-hook.js"],
      "css": ["src/vim-ui.css"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
